{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "target": "ES2020",
        "lib": ["ESNext"],
        "moduleResolution": "nodenext",
        "types": ["node"],
        "module": "nodenext",
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "#src/*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": []
}
